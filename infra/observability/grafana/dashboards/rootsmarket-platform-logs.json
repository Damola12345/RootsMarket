{
  "dashboard_field_changes": {
    "refresh": "30s",
    "time": { "from": "now-15m", "to": "now" },
    "timepicker.refresh_intervals": ["30s", "1m", "5m", "15m"]
  },

  "templating_variable_to_add": {
    "name": "prom",
    "label": "Prometheus datasource",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "options": [],
    "current": {}
  },

  "panels_to_add": [
    {
      "id": 15,
      "title": "Span Export Failures",
      "description": "Spans the collector failed to write to Tempo. Any non-zero value means traces are being lost between the services and Tempo -- the failure mode that looks identical to a propagation bug.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "$prom" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 43 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "expr": "sum(increase(otelcol_exporter_send_failed_spans_total[$__range])) or sum(increase(otelcol_exporter_send_failed_spans[$__range])) or vector(0)"
        }
      ]
    },

    {
      "id": 16,
      "title": "Collector Export Queue",
      "description": "Spans buffered in the exporter sending_queue. Sustained growth means Tempo is not keeping up; reaching queue_size (1000) means spans are being dropped on the floor.",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "$prom" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 43 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "max": 1000,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "expr": "sum(otelcol_exporter_queue_size) or vector(0)"
        }
      ]
    },

    {
      "id": 17,
      "title": "Collector Span Pipeline",
      "description": "Spans per second through the collector. 'accepted' is what the SDKs sent in; 'sent' is what reached Tempo. A gap between those two lines is loss -- 'refused' means memory_limiter shed load, 'failed' means Tempo rejected the write.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "$prom" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 43 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "refused" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "calcs": ["mean", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "accepted",
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total[$__rate_interval])) or sum(rate(otelcol_receiver_accepted_spans[$__rate_interval])) or vector(0)"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "legendFormat": "sent",
          "expr": "sum(rate(otelcol_exporter_sent_spans_total[$__rate_interval])) or sum(rate(otelcol_exporter_sent_spans[$__rate_interval])) or vector(0)"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "legendFormat": "failed",
          "expr": "sum(rate(otelcol_exporter_send_failed_spans_total[$__rate_interval])) or sum(rate(otelcol_exporter_send_failed_spans[$__rate_interval])) or vector(0)"
        },
        {
          "refId": "D",
          "editorMode": "code",
          "legendFormat": "refused",
          "expr": "sum(rate(otelcol_processor_refused_spans_total[$__rate_interval])) or sum(rate(otelcol_processor_refused_spans[$__rate_interval])) or vector(0)"
        }
      ]
    }
  ]
}